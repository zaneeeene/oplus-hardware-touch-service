set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)

set(ANDROID_API_LEVEL "30" CACHE STRING "Android API level")
set(ANDROID_NDK_ROOT "" CACHE PATH "Android NDK root")
set(CPP_CLANG "" CACHE FILEPATH "Host-executable Clang C compiler")
set(CPP_CLANGXX "" CACHE FILEPATH "Host-executable Clang C++ compiler")

if(NOT ANDROID_NDK_ROOT AND DEFINED ENV{ANDROID_NDK_ROOT})
    set(ANDROID_NDK_ROOT "$ENV{ANDROID_NDK_ROOT}")
endif()
if(NOT CPP_CLANG AND DEFINED ENV{CPP_CLANG})
    set(CPP_CLANG "$ENV{CPP_CLANG}")
endif()
if(NOT CPP_CLANGXX AND DEFINED ENV{CPP_CLANGXX})
    set(CPP_CLANGXX "$ENV{CPP_CLANGXX}")
endif()

if(NOT ANDROID_NDK_ROOT)
    message(FATAL_ERROR "ANDROID_NDK_ROOT must point to an Android NDK")
endif()
if(NOT CPP_CLANGXX)
    message(FATAL_ERROR "CPP_CLANGXX must point to a host-executable Clang++")
endif()

get_filename_component(NDK_PREBUILT
    "${ANDROID_NDK_ROOT}/toolchains/llvm/prebuilt/linux-x86_64"
    ABSOLUTE)
set(CMAKE_SYSROOT "${NDK_PREBUILT}/sysroot")

set(CMAKE_C_COMPILER "${CPP_CLANG}" CACHE FILEPATH "" FORCE)
set(CMAKE_CXX_COMPILER "${CPP_CLANGXX}" CACHE FILEPATH "" FORCE)
set(CMAKE_C_COMPILER_TARGET "aarch64-linux-android${ANDROID_API_LEVEL}")
set(CMAKE_CXX_COMPILER_TARGET "aarch64-linux-android${ANDROID_API_LEVEL}")

set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

set(OPLUS_TOUCH_ANDROID ON CACHE BOOL "" FORCE)
set(OPLUS_TOUCH_BUILD_TESTS OFF CACHE BOOL "" FORCE)
